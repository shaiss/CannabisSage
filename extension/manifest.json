{
  "manifest_version": 3,
  "name": "CannabisSage",
  "version": "1.3.23",
  "description": "Chem insights on supported dispensary menus. Free hover/compare; Pro via Stripe on our site. Not medical advice.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CannabisSage — taste map & license",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sunnyside.shop/products/*",
        "https://sunnyside.shop/products/*",
        "https://www.sunnyside.shop/product/*",
        "https://sunnyside.shop/product/*",
        "https://zenleafdispensaries.com/locations/*",
        "https://www.zenleafdispensaries.com/locations/*",
        "https://risecannabis.com/dispensaries/*",
        "https://www.risecannabis.com/dispensaries/*",
        "https://libertycannabis.com/shop/*",
        "https://www.libertycannabis.com/shop/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dutchie.com/embedded-menu/*",
        "https://www.dutchie.com/embedded-menu/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.sunnyside.shop/products/*",
        "https://sunnyside.shop/products/*",
        "https://www.sunnyside.shop/product/*",
        "https://sunnyside.shop/product/*",
        "https://zenleafdispensaries.com/locations/*",
        "https://www.zenleafdispensaries.com/locations/*",
        "https://risecannabis.com/dispensaries/*",
        "https://www.risecannabis.com/dispensaries/*",
        "https://libertycannabis.com/shop/*",
        "https://www.libertycannabis.com/shop/*"
      ],
      "js": [
        "lib/csi-core.js",
        "adapters/interface.js",
        "adapters/sunnyside.js",
        "adapters/zenleaf.js",
        "adapters/terravida.js",
        "adapters/iheartjane.js",
        "adapters/dutchie.js",
        "adapters/registry.js",
        "lib/csi-storage.js",
        "lib/csi-profile.js",
        "lib/csi-fetch.js",
        "lib/csi-glossary.js",
        "lib/csi-entitlement.js",
        "lib/csi-features.js",
        "lib/csi-denylist.js",
        "lib/csi-ui.js",
        "lib/csi-partners.js",
        "content-listing.js",
        "content-pdp.js",
        "content-router.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://dutchie.com/embedded-menu/*",
        "https://www.dutchie.com/embedded-menu/*"
      ],
      "js": [
        "lib/csi-core.js",
        "adapters/interface.js",
        "adapters/sunnyside.js",
        "adapters/zenleaf.js",
        "adapters/terravida.js",
        "adapters/iheartjane.js",
        "adapters/dutchie.js",
        "adapters/registry.js",
        "lib/csi-storage.js",
        "lib/csi-profile.js",
        "lib/csi-fetch.js",
        "lib/csi-glossary.js",
        "lib/csi-entitlement.js",
        "lib/csi-features.js",
        "lib/csi-denylist.js",
        "lib/csi-ui.js",
        "lib/csi-partners.js",
        "content-listing.js",
        "content-pdp.js",
        "content-router.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://www.sunnyside.shop/*",
    "https://sunnyside.shop/*",
    "https://zenleafdispensaries.com/*",
    "https://www.zenleafdispensaries.com/*",
    "https://risecannabis.com/*",
    "https://www.risecannabis.com/*",
    "https://dutchie.com/*",
    "https://www.dutchie.com/*",
    "https://libertycannabis.com/*",
    "https://www.libertycannabis.com/*",
    "https://cannabissage.app/*",
    "https://cannabissage.vercel.app/*",
    "http://localhost:3000/*",
    "https://localhost:3000/*"
  ],
  "optional_host_permissions": [
    "https://*.vercel.app/*"
  ],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": [
        "data/default-taste-map.json",
        "data/terpene-glossary.json",
        "data/config.json"
      ],
      "matches": [
        "https://www.sunnyside.shop/*",
        "https://sunnyside.shop/*",
        "https://zenleafdispensaries.com/*",
        "https://www.zenleafdispensaries.com/*",
        "https://risecannabis.com/*",
        "https://www.risecannabis.com/*",
        "https://dutchie.com/*",
        "https://www.dutchie.com/*",
        "https://libertycannabis.com/*",
        "https://www.libertycannabis.com/*"
      ]
    }
  ]
}
