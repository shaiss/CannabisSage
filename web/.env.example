# CannabisSage web (landing + Stripe entitlement API)
#
# Copy to .env.local and fill in Stripe Dashboard values.
# Never commit real secrets.

# Public site URL (no trailing slash) — used for Checkout success/cancel + portal return
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode keys for local)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs from Stripe Dashboard (Products → CannabisSage Pro annual)
# Launch promo $10/year — create this recurring yearly price
STRIPE_PRICE_ID_PROMO=price_...
# After promo window — set when you decide; leave blank to reuse promo price
# STRIPE_PRICE_ID_AFTER_PROMO=price_...
# Or override unit amount display only (Checkout still uses price IDs above):
# PRICE_AFTER_PROMO_CENTS=1000

# Launch clock for 30-day $10/yr promo (ISO date, UTC midnight)
LAUNCH_DATE=2026-09-20
PROMO_DAYS=30

# Optional: allow mock licenses without Stripe (local UI only)
# ALLOW_DEV_MOCK=1
