{
  "manifest_version": 3,
  "name": "CannabisSage",
  "version": "1.1.0",
  "description": "Cannabinoid and terpene insights on Sunnyside listings and product pages: compare, filter, sort, and taste-map match — no medical claims.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CannabisSage — taste map & settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sunnyside.shop/products/*",
        "https://sunnyside.shop/products/*",
        "https://www.sunnyside.shop/product/*",
        "https://sunnyside.shop/product/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.sunnyside.shop/products/*",
        "https://sunnyside.shop/products/*"
      ],
      "js": [
        "lib/csi-core.js",
        "lib/csi-storage.js",
        "lib/csi-fetch.js",
        "lib/csi-glossary.js",
        "lib/csi-ui.js",
        "content-listing.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.sunnyside.shop/product/*",
        "https://sunnyside.shop/product/*"
      ],
      "js": [
        "lib/csi-core.js",
        "lib/csi-storage.js",
        "lib/csi-fetch.js",
        "lib/csi-glossary.js",
        "lib/csi-ui.js",
        "content-pdp.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "host_permissions": [
    "https://www.sunnyside.shop/*",
    "https://sunnyside.shop/*"
  ],
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": [
        "data/default-taste-map.json",
        "data/terpene-glossary.json"
      ],
      "matches": [
        "https://www.sunnyside.shop/*",
        "https://sunnyside.shop/*"
      ]
    }
  ]
}
