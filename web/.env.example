# CannabisSage web (landing + Stripe entitlement API)
#
# Copy to .env.local and fill in values from Vercel / Stripe Dashboard (test mode).
# Never commit real secrets.

# Public site URL (no trailing slash) — Checkout success/cancel + portal return
# Prod: https://cannabissage.app (Vercel fallback alias: https://cannabissage.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon (Vercel Marketplace → cannabissage-db). Prefer DATABASE_URL.
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
# POSTGRES_URL=

# Stripe (test mode keys for local / Cipher gate — no prod key claims)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs — Stack / Vercel env names (Shai pricing lock)
# Launch promo (LAUNCH_DATE + PROMO_DAYS):
STRIPE_PRICE_ID_PROMO=price_...              # $9/year promo
STRIPE_PRICE_ID_PROMO_MONTHLY=price_...      # $4/month promo
# After promo window:
STRIPE_PRICE_ID_REGULAR_ANNUAL=price_...     # $99/year (alias: STRIPE_PRICE_ID_AFTER_PROMO)
STRIPE_PRICE_ID_REGULAR_MONTHLY=price_...    # $9/month
# STRIPE_PRICE_ID_AFTER_PROMO=price_...      # legacy alias for REGULAR_ANNUAL
# Optional alias for annual promo only:
# STRIPE_PRICE_ID=price_...

# Marketplace sandbox (test) — partial; Assay fills remainder on Vercel:
# STRIPE_PRICE_ID_PROMO_MONTHLY=price_1UHikzATpHsAXg8mLqGkTbdi
# STRIPE_PRICE_ID_REGULAR_ANNUAL=price_1UHikzATpHsAXg8mECO1ZvjR

LAUNCH_DATE=2026-09-20
PROMO_DAYS=30

# ALLOW_DEV_MOCK=1
# SMOKE_LIVE=1
