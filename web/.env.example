# CannabisSage web (landing + Stripe entitlement API)
#
# Copy to .env.local and fill in values from Vercel / Stripe Dashboard (test mode).
# Never commit real secrets.

# Public site URL (no trailing slash) — Checkout success/cancel + portal return
# Prod alias: https://cannabissage.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon (Vercel Marketplace → cannabissage-db). Prefer DATABASE_URL.
# POSTGRES_URL is accepted as an alias when Marketplace injects it.
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
# POSTGRES_URL=

# Stripe (test mode keys for local / Cipher gate — no prod key claims)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Some Marketplace bindings expose STRIPE_PUBLISHABLE_KEY without the NEXT_PUBLIC_ prefix;
# set NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY for client Checkout button usage.

# Price IDs from Stripe Dashboard (Products → CannabisSage Pro annual)
# Launch promo $10/year — create this recurring yearly price (env-driven; required for Checkout)
STRIPE_PRICE_ID_PROMO=price_...
# Optional alias for STRIPE_PRICE_ID_PROMO:
# STRIPE_PRICE_ID=price_...
# After promo window — set when you decide; leave blank to reuse promo price
# STRIPE_PRICE_ID_AFTER_PROMO=price_...
# Or override unit amount display only (Checkout still uses price IDs above):
# PRICE_AFTER_PROMO_CENTS=1000

# Launch clock for 30-day $10/yr promo (ISO date, UTC midnight)
LAUNCH_DATE=2026-09-20
PROMO_DAYS=30

# Optional: allow mock licenses + local .data file store WITHOUT DATABASE_URL (local UI only).
# Prod must set DATABASE_URL and leave this unset/0 (fail closed).
# ALLOW_DEV_MOCK=1

# Optional gated live smoke (requires Stripe test keys + DATABASE_URL):
# SMOKE_LIVE=1
